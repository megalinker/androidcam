<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pc_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/pc_bg"
        app:title="PhoneCam"
        app:titleTextColor="@color/pc_text"
        app:subtitleTextColor="@color/pc_muted"
        app:titleCentered="false" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="28dp">

            <TextView style="@style/PcSectionLabel" android:text="MODE" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeBoth" style="@style/PcSegment"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:text="Cam + Mic" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeCamera" style="@style/PcSegment"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:text="Camera" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeMic" style="@style/PcSegment"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:text="Mic" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView style="@style/PcSectionLabel" android:text="QUALITY" android:layout_marginTop="20dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/qualityLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/qualityInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/pc_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Primary action: scan the QR the PhoneCam PC app shows to pair over WebRTC. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanBtn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Scan PC QR to connect"
                android:textSize="16sp"
                app:cornerRadius="14dp" />

            <!-- One-tap reconnect to the last PC (shown only after pairing once). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reconnectBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="🔒 Reconnect to last PC"
                android:textSize="15sp"
                android:visibility="gone"
                app:cornerRadius="14dp" />

            <!-- Stop-only; shown while streaming (the phone connects out, so there's no idle "start"). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/startBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="Stop streaming"
                android:textSize="15sp"
                android:visibility="gone"
                app:cornerRadius="14dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/pc_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/pc_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/liveLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Streaming"
                        android:textColor="@color/pc_green"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="CONNECTED TO"
                        android:textColor="@color/pc_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <!-- The PC we're streaming to (LAN-direct over WebRTC). Tap to copy the address. -->
                    <TextView
                        android:id="@+id/urlText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/pc_url_bg"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:gravity="center"
                        android:textColor="@color/pc_text"
                        android:textIsSelectable="true"
                        android:fontFamily="monospace"
                        android:textSize="16sp"
                        tools:text="192.168.0.180" />

                    <TextView
                        android:id="@+id/urlHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="🔒 Encrypted (DTLS-SRTP)"
                        android:textColor="@color/pc_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/pcStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Waiting for the PC to connect…"
                        android:textColor="@color/pc_muted"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/switchCamBtn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Switch camera" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Diagnostics: OFF by default. Recording costs a little battery itself (a 30 s sampler
                 + logging), so it is opt-in and clearly labelled as a measurement tool. -->
            <TextView style="@style/PcSectionLabel" android:text="DIAGNOSTICS" android:layout_marginTop="24dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/diagSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Record battery diagnostics"
                android:textColor="@color/pc_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/diagHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Off. Turn on only while measuring — it samples power, thermals and CPU every 30 s and uses a little battery itself."
                android:textColor="@color/pc_muted"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/diagShareBtn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:visibility="gone"
                android:text="Share diagnostics" />

            <TextView
                android:id="@+id/idleHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Pick a mode, then tap Scan and point the camera at the QR in the PhoneCam app on your PC. Keep the phone and PC on the same Wi-Fi."
                android:textColor="@color/pc_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
